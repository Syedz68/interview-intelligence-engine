PROJECT_NAME=Interview Intelligence Core Engine
VERSION=1.0.0
ENV=development
DEBUG=True

SECRET_KEY=THIS_IS_DESIGNED_FOR_INTERVIEW_INTELLIGENCE_CORE_ENGINE
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]

# ── Ollama AI Settings ──────────────────────────────────────────────────────────
# Used for: English Fluency AI, Answer Relevance AI, Behavioral Report AI
#
# LOCAL SETUP (default — zero cost)
# 1. Install Ollama:  https://ollama.com/download
# 2. Pull a model:    ollama pull llama3.1
# 3. Start server:    ollama serve   (or it auto-starts on most platforms)
# 4. Leave OLLAMA_BASE_URL as-is
#
# CLOUD / REMOTE SETUP
# Point OLLAMA_BASE_URL at your hosted Ollama instance.
# If the server requires authentication, set OLLAMA_API_KEY.
#
# RECOMMENDED MODELS  (set OLLAMA_MODEL to one of these)
# ┌─────────────┬──────────────────────────┬─────────────────────┐
# │ Model       │ Quality                  │ Min RAM/VRAM        │
# ├─────────────┼──────────────────────────┼─────────────────────┤
# │ llama3.1    │ Best (default)           │ ~8 GB               │
# │ mistral     │ Fast + good quality      │ ~5 GB               │
# │ gemma2      │ Strong structured output │ ~5 GB               │
# │ qwen2.5     │ Excellent JSON adherence │ ~5 GB               │
# │ phi3        │ Lightweight (CPU-OK)     │ ~4 GB               │
# └─────────────┴──────────────────────────┴─────────────────────┘

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=3
# OLLAMA_API_KEY=                      # only needed for authenticated cloud servers

# ── Hugging Face Token (for Speaker Diarization) ──────────────────────────────
# Required for separating interviewer vs candidate speech.
#
# 1. Create account: https://huggingface.co
# 2. Get token:      https://hf.co/settings/tokens  (use "read" scope)
# 3. Accept terms:   https://hf.co/pyannote/speaker-diarization-3.1
# 4. Paste below
#
# If missing or blank, diarization is skipped (other features still work).
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# ── Behavioral Aggregator Weights (optional, defaults shown) ──────────────────
W_COMMUNICATION=0.40
W_ENGAGEMENT=0.30
W_CONFIDENCE=0.20
W_PROFESSIONALISM=0.10-e
# Microservice URLs
AUDIO_SERVICE_URL=http://localhost:8001
