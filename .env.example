PROJECT_NAME=Interview Intelligence Core Engine
VERSION=1.0.0
ENV=development
DEBUG=True

SECRET_KEY=THIS_IS_DESIGNED_FOR_INTERVIEW_INTELLIGENCE_CORE_ENGINE
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]

# ── Gemini AI Keys ─────────────────────────────────────────────────────────────
# Required for: English Fluency AI, Answer Relevance AI, Behavioral Report AI
#
# Add up to 3 keys to spread load across them and avoid 429 rate-limit errors.
# Each of the 3 AI services preferentially uses a different key.
# On 429, the client automatically rotates to the next available key.
#
# Get free API keys at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...your_primary_key...
GEMINI_API_KEY_2=AIza...your_second_key...   # optional
GEMINI_API_KEY_3=AIza...your_third_key...    # optional

# ── Hugging Face Token (for Speaker Diarization) ──────────────────────────────
# Required for separating interviewer vs candidate speech.
#
# Steps:
#   1. Create account at https://huggingface.co
#   2. Get your token at: https://hf.co/settings/tokens  (use "read" scope)
#   3. Accept model terms at: https://hf.co/pyannote/speaker-diarization-3.1
#      (click "Agree and access repository" — required even for free tier)
#   4. Paste your token below
#
# If HF_TOKEN is missing or blank, diarization is skipped and the full
# transcript is attributed to the candidate (other features still work).
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# ── Behavioral Aggregator Weights (optional, defaults shown) ──────────────────
W_COMMUNICATION=0.40
W_ENGAGEMENT=0.30
W_CONFIDENCE=0.20
W_PROFESSIONALISM=0.10
